{
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git checkout -b *)",
      "Bash(git push -u origin *)",
      "Bash(gh pr create *)",
      "Bash(pnpm lint)",
      "Bash(pnpm -s lint)",
      "Bash(pnpm format:check)",
      "Bash(pnpm -s format:check)",
      "Bash(pnpm test)",
      "Bash(pnpm -s test)",
      "Bash(pnpm exec tsc --noEmit)",
      "Bash(supabase test db)",
      "Bash(supabase test db *)",
      "Bash(supabase status)",
      "Bash(supabase status *)",
      "Bash(supabase gen types *)",
      "Bash(.githooks/test.sh)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/git-guard.sh" }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/push-nudge.sh start" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/push-nudge.sh stop" }
        ]
      }
    ]
  }
}
