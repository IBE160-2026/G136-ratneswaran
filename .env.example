# Local defaults from `supabase start`. Copy to .env.local; nothing here is a real secret.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# Copy the secret key from `supabase status -o env` (SECRET_KEY) after `supabase start`.
SUPABASE_SECRET_KEY=

# Web Push public key, needed only from Epic 10. Leave empty until then.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# AI runs on fixtures in supabase/fixtures/ai unless set to true (AD-9).
AI_LIVE=false
